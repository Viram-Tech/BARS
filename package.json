{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @workspace/bars-platform run dev",
    "dev:web": "pnpm --filter @workspace/bars-platform run dev",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "build:web": "pnpm --filter @workspace/bars-platform run build",
    "build:api": "pnpm --filter @workspace/api-server run build",
    "preview": "pnpm --filter @workspace/bars-platform run serve",
    "start": "pnpm --filter @workspace/bars-platform run serve",
    "start:web": "pnpm --filter @workspace/bars-platform run serve",
    "start:api": "pnpm --filter @workspace/api-server run start",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@9.5.0"
}
